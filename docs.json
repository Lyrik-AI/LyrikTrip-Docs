{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "AnyAgent",
  "colors": {
    "primary": "#0D9373",
    "light": "#14B8A6",
    "dark": "#2DD4BF"
  },
  "favicon": "/favicon.svg",
  "icons": {
    "library": "lucide"
  },
  "appearance": {
    "default": "system"
  },
  "navigation": {
    "groups": [
      {
        "group": "Start here",
        "icon": "rocket",
        "pages": [
          "index",
          "quickstart",
          "concepts/documentation-system"
        ]
      },
      {
        "group": "Guides",
        "icon": "book-open",
        "pages": [
          "guides/configuration",
          "guides/agent-server",
          "guides/security-boundaries"
        ]
      },
      {
        "group": "Reference",
        "icon": "map",
        "pages": [
          "reference/architecture-map",
          "reference/mintlify-publishing"
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/Lyrik-AI/AnyAgent"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Quickstart",
      "href": "/quickstart"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/Lyrik-AI/AnyAgent"
    }
  }
}
